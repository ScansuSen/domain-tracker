# Relative on purpose: in dev, requests to /api are proxied to the backend by Vite itself
# (see vite.config.ts), so the browser never makes a cross-origin request and DomainTracker.API
# needs no CORS configuration. If frontend and API are deployed on different origins in
# production, point this at the API's absolute URL and make sure it allows that origin via CORS.
VITE_API_BASE_URL=/api

# Where the Vite dev server proxies /api to. Not prefixed with VITE_, so it stays server-side and
# is never bundled into the app. Matches DomainTracker.API's "https" launch profile.
API_PROXY_TARGET=https://localhost:7253
